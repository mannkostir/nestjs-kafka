{
  "name": "nestjs-kafka-connector",
  "version": "0.1.0",
  "description": "NestJS Kafka Connector",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannkostir/nestjs-kafka.git"
  },
  "homepage": "https://github.com/mannkostir/nestjs-kafka#readme",
  "bugs": {
    "url": "https://github.com/mannkostir/nestjs-kafka/issues"
  },
  "keywords": [
    "nestjs",
    "kafka",
    "kafkajs",
    "dlq",
    "dead-letter",
    "avro",
    "namespace",
    "multi-environment"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration --runInBand --testTimeout=180000"
  },
  "peerDependencies": {
    "@kafkajs/confluent-schema-registry": ">=3.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "kafkajs": ">=2.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@kafkajs/confluent-schema-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/testing": "^11.2.6",
    "@testcontainers/kafka": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.1",
    "kafkajs": "^2.2.4",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.0"
  }
}
