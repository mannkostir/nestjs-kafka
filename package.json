{
  "name": "nestjs-kafka-connector",
  "version": "0.2.1",
  "description": "NestJS Kafka Connector",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannkostir/nestjs-kafka.git"
  },
  "homepage": "https://github.com/mannkostir/nestjs-kafka#readme",
  "bugs": {
    "url": "https://github.com/mannkostir/nestjs-kafka/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "nestjs",
    "kafka",
    "kafkajs",
    "dlq",
    "dead-letter",
    "avro",
    "namespace",
    "multi-environment"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:compile": "tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && node scripts/write-entry-points.js",
    "build": "npm run build:compile && node scripts/check-entry-points.js",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects unit --passWithNoTests",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects integration --runInBand --testTimeout=180000"
  },
  "peerDependencies": {
    "@kafkajs/confluent-schema-registry": ">=3.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "kafkajs": ">=2.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@kafkajs/confluent-schema-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@testcontainers/kafka": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.1",
    "kafkajs": "^2.2.4",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.0"
  }
}
